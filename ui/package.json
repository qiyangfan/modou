{
  "name": "modou-ui",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "墨斗本地薄报告层：渲染 verify/optimize/lint/patrol 报告（仅 localhost，只读）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "npm run build && vitest run --coverage",
    "coverage": "vitest run --coverage",
    "dup:check": "jscpd ../src/modou src --exit-code",
    "style:check": "stylelint \"src/**/*.css\"",
    "arch:check": "depcruise src",
    "docs:check": "markdownlint-cli2",
    "docs:format:check": "prettier --check \"../README.md\" \"../README.en.md\" \"../AGENTS.md\" \"../docs/**/*.md\" \"../.github/**/*.yml\" \"../openspec/**/*.md\" \"../openspec/**/*.yaml\" \"../examples/ci/*.yml\" \"../.pre-commit-config.yaml\" \"../.yamllint.yml\"",
    "dead:check": "knip --include exports,files,dependencies"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.13.0",
    "jscpd": "^5.4.3",
    "jsdom": "^30.1.3",
    "knip": "^6.46.1",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
